# Postgres on minipi, reached publicly through Tailscale Funnel (TLS + password).
# The app user owns only this database; its password is in the Pi's docker/postgres/app-password
DATABASE_URL=postgres://scrumspecter_app:<password>@minipi.<tailnet>.ts.net:10000/scrumspecter
# "direct" on Vercel (Funnel needs TLS from the first byte); leave unset on the tailnet;
# "false" only for a local non-TLS database
DATABASE_SSL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/routines (Vercel Cron) and /api/cron/reminders (the Pi's crontab),
# sent as a Bearer token
CRON_SECRET=

# Signs the short-lived cookie that links a Google sign-in to an existing password account
AUTH_LINK_SECRET=

# Google sign-in (optional; the button only shows when both are set).
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Push notifications (optional): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Password-reset emails through Resend (optional; without them the link is printed to the
# server log). Without your own domain, Resend only delivers to the account owner's address
RESEND_API_KEY=
EMAIL_FROM=ScrumSpecter <onboarding@resend.dev>

# "off" turns off the public-holiday feed
HOLIDAY_FEED=
